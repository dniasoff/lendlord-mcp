{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.dniasoff/lendlord-mcp",
  "description": "Manage a Lendlord landlord account: properties, documents, tenants, maintenance, tasks, email filing.",
  "repository": {
    "url": "https://github.com/dniasoff/lendlord-mcp",
    "source": "github"
  },
  "version": "0.4.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "lendlord-mcp",
      "version": "0.4.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "LENDLORD_EMAIL",
          "description": "Lendlord login email",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "LENDLORD_PASSWORD",
          "description": "Lendlord password",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "LENDLORD_TOTP_SECRET",
          "description": "Base32 TOTP secret if 2FA is enabled",
          "isRequired": false,
          "isSecret": true
        },
        {
          "name": "LENDLORD_READ_ONLY",
          "description": "true disables all write tools",
          "isRequired": false,
          "isSecret": false
        },
        {
          "name": "LENDLORD_AUTO_CONFIRM",
          "description": "true skips the once-per-session write confirmation",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
